dist/

# LaTeX build artifacts (cv/)
# Note: only cv/*.pdf is ignored, NOT public/docs/*.pdf -- the installed copy
# at public/docs/Lin-Ren-CV.pdf must stay in the repo, since Cloudflare Pages
# has no LaTeX toolchain and cannot regenerate it.
