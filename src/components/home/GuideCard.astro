---
import { Icon } from "astro-icon/components";

interface Props {
	href: string;
	title: string;
	external?: boolean;
	class?: string;
	style?: string;
}

const { href, title, external = false, style } = Astro.props;
const className = Astro.props.class;
---
<a href={href}
   target={external ? "_blank" : null}
   rel={external ? "noopener noreferrer" : null}
   style={style}
   class:list={[className, "guide-card group relative flex items-center gap-2 rounded-xl pl-4 pr-3 py-2.5 transition",
       "hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)]"]}
>
    <span class="flex-1 min-w-0 font-medium text-90 transition group-hover:text-[var(--primary)]">{title}</span>
    <Icon name={external ? "material-symbols:north-east-rounded" : "material-symbols:chevron-right-rounded"}
          class="shrink-0 text-[1.1rem] text-30 transition group-hover:text-[var(--primary)]"
    ></Icon>
</a>

<style>
/* 左侧竖条，悬停时从中间展开 */
.guide-card::before {
    content: "";
    position: absolute;
    left: 0;
    top: .5rem;
    bottom: .5rem;
    width: 3px;
    border-radius: 3px;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform .3s cubic-bezier(.22, 1, .36, 1);
}
.guide-card:hover::before {
    transform: scaleY(1);
}
</style>
